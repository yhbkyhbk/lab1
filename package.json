{
  "name": "svg-editor-cli",
  "version": "0.1.0",
  "private": true,
  "description": "A command-line SVG editor for Lab1 Phase 1",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build --silent && node --test dist/test/TestSuite.js",
    "test:acceptance": "npm run build --silent && node --test dist/test/AcceptanceSuite.js",
    "test:coverage": "npm run build --silent && node --test --experimental-test-coverage --test-coverage-include=dist/src/** dist/test/TestSuite.js",
    "check:architecture": "node scripts/ArchitectureAudit.mjs",
    "cli": "npm run build --silent && node dist/src/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  }
}
